#: prefs.js (Downloads page)
msgid "Downloads"
msgstr "Downloads"

msgid "Download Settings"
msgstr "Configurações de Download"

msgid "Download Folder"
msgstr "Pasta de Download"

msgid "Set as Wallpaper"
msgstr "Definir como Papel de Parede"

msgid "Automatically apply the downloaded wallpaper"
msgstr "Aplicar automaticamente o wallpaper baixado"

msgid "Page Size"
msgstr "Tamanho da Página"

msgid "Number of wallpapers per page (1-24)"
msgstr "Número de wallpapers por página (1-24)"

#: prefs.js (Help Center page)
msgid "Help Center"
msgstr "Central de Ajuda"

msgid "Provider Setup Guides"
msgstr "Guias de Configuração de Provedores"

msgid "Step-by-step instructions to configure each wallpaper provider."
msgstr "Instruções passo a passo para configurar cada provedor de wallpapers."

msgid "Wallhaven"
msgstr "Wallhaven"

msgid "Wallpaper community with SFW, Sketchy, and NSFW content."
msgstr "Comunidade de wallpapers com conteúdo SFW, Sketchy e NSFW."

msgid "Create an account at wallhaven.cc"
msgstr "Crie uma conta no wallhaven.cc"

msgid "Go to Account Settings and generate an API key"
msgstr "Vá para Configurações da Conta e gere uma chave de API"

msgid "Paste the API key in the Providers tab above"
msgstr "Cole a chave de API na aba Provedores acima"

msgid "No official rate limit, but be respectful (max ~3 req/s recommended)."
msgstr "Sem limite de taxa oficial, mas seja respeitoso (máx ~3 req/s recomendado)."

msgid "Pexels"
msgstr "Pexels"

msgid "Free high-quality stock photos and wallpapers."
msgstr "Fotos e wallpapers de alta qualidade gratuitos."

msgid "Create a free account at pexels.com"
msgstr "Crie uma conta gratuita no pexels.com"

msgid "Go to pexels.com/api and request an API key"
msgstr "Vá para pexels.com/api e solicite uma chave de API"

msgid "200 requests/hour for free accounts."
msgstr "200 requisições/hora para contas gratuitas."

msgid "Unsplash"
msgstr "Unsplash"

msgid "High-resolution free photography."
msgstr "Fotografia gratuita em alta resolução."

msgid "Create an account at unsplash.com"
msgstr "Crie uma conta no unsplash.com"

msgid "Go to unsplash.com/developers and create an application"
msgstr "Vá para unsplash.com/developers e crie uma aplicação"

msgid "Copy the Access Key and paste in the Providers tab above"
msgstr "Copie a Chave de Acesso e cole na aba Provedores acima"

msgid "50 requests/hour for demo apps, 5000/hour for production."
msgstr "50 requisições/hora para apps de demonstração, 5000/hora para produção."

msgid "Anime image board — SFW only, no API key required."
msgstr "Board de imagens de anime — apenas SFW, nenhuma chave de API necessária."

msgid "No API key needed — just select Safebooru in the Providers tab"
msgstr "Nenhuma chave de API necessária — basta selecionar Safebooru na aba Provedores"

msgid "Use tags separated by spaces in the search query"
msgstr "Use tags separadas por espaços na consulta de busca"

msgid "Safebooru only serves SFW content"
msgstr "Safebooru serve apenas conteúdo SFW"

msgid "Be respectful; avoid excessive rapid requests."
msgstr "Seja respeitoso; evite requisições rápidas excessivas."

msgid "Pixabay"
msgstr "Pixabay"

msgid "Free images with a permissive license."
msgstr "Imagens gratuitas com licença permissiva."

msgid "Create a free account at pixabay.com"
msgstr "Crie uma conta gratuita no pixabay.com"

msgid "Go to pixabay.com/api/docs and copy your API key"
msgstr "Vá para pixabay.com/api/docs e copie sua chave de API"

msgid "100 requests/hour for free accounts (basic key)."
msgstr "100 requisições/hora para contas gratuitas (chave básica)."

msgid "Waifu.im"
msgstr "Waifu.im"

msgid "Curated anime image archive — SFW only, no API key required."
msgstr "Arquivo de imagens de anime com curadoria — somente SFW, sem necessidade de chave de API."

msgid "No API key needed — just select Waifu.im in the Providers tab"
msgstr "Nenhuma chave de API necessária — basta selecionar Waifu.im na aba Provedores"

msgid "Use tags separated by spaces in the search query (e.g. \"maid uniform\")"
msgstr "Use tags separadas por espaços na busca (ex.: \"maid uniform\")"

msgid "Leave the query empty to browse random waifus"
msgstr "Deixe a busca vazia para ver waifus aleatórias"

msgid "1 request every 200ms. Each search returns up to 30 fresh random images."
msgstr "1 requisição a cada 200ms. Cada busca retorna até 30 imagens aleatórias."

msgid "Local Files"
msgstr "Arquivos Locais"

msgid "Search wallpapers in folders on this computer."
msgstr "Busque papéis de parede em pastas deste computador."

msgid "Default Folder"
msgstr "Pasta Padrão"

msgid "Not found"
msgstr "Não encontrada"

msgid "Extra Folders"
msgstr "Pastas Extras"

msgid "/home/user/Wallpapers:/mnt/photos"
msgstr "/home/usuario/Wallpapers:/mnt/fotos"

msgid "Separate multiple folders with a colon (:)"
msgstr "Separe múltiplas pastas com dois-pontos (:)"

msgid "Include Subfolders"
msgstr "Incluir Subpastas"

msgid "Search inside subfolders recursively"
msgstr "Buscar dentro das subpastas recursivamente"

msgid "Your own image collection on this computer — no network needed."
msgstr "Sua própria coleção de imagens neste computador — sem necessidade de rede."

msgid "Your Pictures folder is searched by default"
msgstr "Sua pasta Imagens é pesquisada por padrão"

msgid "Add more folders in the Providers tab, separated by colons"
msgstr "Adicione mais pastas na aba Provedores, separadas por dois-pontos"

msgid "Toggle subfolder search and leave the query empty to browse everything"
msgstr "Ative a busca em subpastas e deixe a busca vazia para ver tudo"

msgid "General Tips"
msgstr "Dicas Gerais"

msgid "Switching Providers"
msgstr "Alternando Provedores"

msgid "Select a provider in the Providers tab. Each provider has its own search filters and content. You can switch at any time."
msgstr "Selecione um provedor na aba Provedores. Cada provedor tem seus próprios filtros de busca e conteúdo. Você pode alternar a qualquer momento."

msgid "NSFW Content"
msgstr "Conteúdo NSFW"

msgid "NSFW content is only available through Wallhaven and requires a valid API key. Enable the NSFW purity filter only if you have a Wallhaven API key configured."
msgstr "Conteúdo NSFW está disponível apenas através do Wallhaven e requer uma chave de API válida. Ative o filtro de pureza NSFW apenas se tiver uma chave de API do Wallhaven configurada."

msgid "Safebooru Tag Syntax"
msgstr "Sintaxe de Tags do Safebooru"

msgid "Safebooru uses tags for search. Use underscores for multi-word tags (e.g. \"blue_hair, solo\"). Combine tags with commas."
msgstr "Safebooru usa tags para busca. Use underscores para tags com múltiplas palavras (ex: \"blue_hair, solo\"). Combine tags com vírgulas."

#: prefs.js (Video page)
msgid "Video"
msgstr "Vídeo"

msgid "Source"
msgstr "Fonte"

msgid "Configure the video wallpaper source."
msgstr "Configure a fonte do papel de parede em vídeo."

msgid "Enable Video Mode"
msgstr "Ativar Modo Vídeo"

msgid "Switch from image browsing to video wallpaper mode"
msgstr "Alternar da navegação de imagens para o modo de papel de parede em vídeo"

msgid "Source Type"
msgstr "Tipo de Fonte"

msgid "Type of video source"
msgstr "Tipo de fonte de vídeo"

msgid "Video Folder"
msgstr "Pasta de Vídeos"

msgid "Video Path"
msgstr "Caminho do Vídeo"

msgid "Streaming URL"
msgstr "URL de Streaming"

msgid "Webpage URL"
msgstr "URL da Página Web"

msgid "Local HTML File"
msgstr "Arquivo HTML Local"

msgid "Playback"
msgstr "Reprodução"

msgid "Audio and video playback settings."
msgstr "Configurações de reprodução de áudio e vídeo."

msgid "Volume"
msgstr "Volume"

msgid "Audio volume of the video wallpaper (0-100)"
msgstr "Volume do áudio do papel de parede em vídeo (0-100)"

msgid "Mute"
msgstr "Silenciar"

msgid "Mute the video wallpaper audio"
msgstr "Silenciar o áudio do papel de parede em vídeo"

msgid "Fade Duration"
msgstr "Duração do Fade"

msgid "Volume fade duration in seconds"
msgstr "Duração do fade de volume em segundos"

msgid "Audio Only on Primary Monitor"
msgstr "Áudio Apenas no Monitor Principal"

msgid "Play audio only on the primary monitor"
msgstr "Reproduzir áudio apenas no monitor principal"

msgid "Fit Mode"
msgstr "Modo de Ajuste"

msgid "How the video is fitted on screen"
msgstr "Como o vídeo é ajustado na tela"

msgid "Random Start"
msgstr "Início Aleatório"

msgid "Seek to a random position when playback starts"
msgstr "Ir para uma posição aleatória quando a reprodução iniciar"

msgid "Per-Monitor Video Paths"
msgstr "Caminhos de Vídeo por Monitor"

msgid "Auto-Pause"
msgstr "Auto-Pausa"

msgid "Automatically pause the video wallpaper."
msgstr "Pausar automaticamente o papel de parede em vídeo."

msgid "Never"
msgstr "Nunca"

msgid "Any monitor"
msgstr "Qualquer monitor"

msgid "All monitors"
msgstr "Todos os monitores"

msgid "Pause on Maximize/Fullscreen"
msgstr "Pausar ao Maximizar/Tela Cheia"

msgid "Pause video when a window is maximized or fullscreen"
msgstr "Pausar o vídeo quando uma janela estiver maximizada ou em tela cheia"

msgid "Pause on Window Focus"
msgstr "Pausar ao Focar Janela"

msgid "Pause video whenever any window has focus"
msgstr "Pausar o vídeo sempre que uma janela tiver foco"

msgid "Pause on Battery"
msgstr "Pausar na Bateria"

msgid "Pause video based on power status"
msgstr "Pausar o vídeo com base no status da energia"

msgid "Low battery"
msgstr "Bateria baixa"

msgid "Always"
msgstr "Sempre"

msgid "Low Battery Threshold"
msgstr "Limite de Bateria Baixa"

msgid "Battery percentage below which to pause"
msgstr "Porcentagem da bateria abaixo da qual pausar"

msgid "Pause on Media Playing"
msgstr "Pausar ao Reproduzir Mídia"

msgid "Pause video whenever a media player is playing"
msgstr "Pausar o vídeo sempre que um reprodutor de mídia estiver reproduzindo"

msgid "Auto-Change"
msgstr "Auto-Troca"

msgid "Automatically change the video wallpaper periodically."
msgstr "Trocar automaticamente o papel de parede em vídeo periodicamente."

msgid "Auto-Change Wallpaper"
msgstr "Auto-Trocar Papel de Parede"

msgid "Periodically change the video wallpaper from a directory"
msgstr "Trocar periodicamente o papel de parede em vídeo de um diretório"

msgid "Auto-Change Directory"
msgstr "Diretório de Auto-Troca"

msgid "Auto-Change Interval"
msgstr "Intervalo de Auto-Troca"

msgid "Minutes between automatic wallpaper changes"
msgstr "Minutos entre as trocas automáticas de papel de parede"

msgid "Change Mode"
msgstr "Modo de Troca"

msgid "Order when changing wallpapers"
msgstr "Ordem ao trocar papéis de parede"

msgid "Sequential"
msgstr "Sequencial"

msgid "Reverse"
msgstr "Invertido"

msgid "Random"
msgstr "Aleatório"

msgid "Static"
msgstr "Estático"

msgid "Extract a frame from the video as static wallpaper."
msgstr "Extrair um quadro do vídeo como papel de parede estático."

msgid "Extract Static Wallpaper from Video"
msgstr "Extrair Papel de Parede Estático do Vídeo"

msgid "Extract a frame and set it as the static desktop background"
msgstr "Extrair um quadro e defini-lo como fundo da área de trabalho estático"

msgid "Blur Static Wallpaper"
msgstr "Desfocar Papel de Parede Estático"

msgid "Blur the extracted frame before setting as wallpaper"
msgstr "Desfocar o quadro extraído antes de definir como papel de parede"

msgid "Blur Radius"
msgstr "Raio de Desfoque"

msgid "Gaussian blur radius for the static wallpaper"
msgstr "Raio de desfoque gaussiano para o papel de parede estático"

msgid "Advanced"
msgstr "Avançado"

msgid "Show on Lock Screen"
msgstr "Mostrar na Tela de Bloqueio"

msgid "Keep the video wallpaper visible on the lock screen"
msgstr "Manter o papel de parede em vídeo visível na tela de bloqueio"

msgid "Startup Delay"
msgstr "Atraso na Inicialização"

msgid "Milliseconds to wait before launching the renderer"
msgstr "Milissegundos a aguardar antes de iniciar o renderizador"

msgid "Show Panel Menu"
msgstr "Mostrar Menu do Painel"

msgid "Show the video control menu in the panel"
msgstr "Mostrar o menu de controle de vídeo no painel"

msgid "Enable VA-API Hardware Decoding"
msgstr "Ativar Decodificação por Hardware VA-API"

msgid "Prefer VA-API hardware decoding for the video wallpaper"
msgstr "Preferir decodificação por hardware VA-API para o papel de parede em vídeo"

msgid "Enable NVIDIA Stateless Decoders"
msgstr "Ativar Decodificadores NVIDIA Stateless"

msgid "Use NVIDIA stateless decoders for hardware decoding"
msgstr "Usar decodificadores NVIDIA stateless para decodificação por hardware"

msgid "Prefer Clappersink"
msgstr "Preferir Clappersink"

msgid "Prefer clappersink over gtk4paintablesink"
msgstr "Preferir clappersink ao invés de gtk4paintablesink"

msgid "Force GTK MediaFile Backend"
msgstr "Forçar Backend GTK MediaFile"

msgid "Use Gtk.MediaFile backend instead of GStreamer"
msgstr "Usar o backend Gtk.MediaFile ao invés do GStreamer"

